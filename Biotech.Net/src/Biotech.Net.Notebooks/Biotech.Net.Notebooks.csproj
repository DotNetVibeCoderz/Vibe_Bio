  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.Interactive.Formatting" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Interactive runs this script when the package is referenced with #r "nuget:...". -->
    <None Include="extension.dib" Pack="true" PackagePath="interactive-extensions/dotnet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Biotech.Net.Notebooks.Tests" />
  </ItemGroup>

</Project>
