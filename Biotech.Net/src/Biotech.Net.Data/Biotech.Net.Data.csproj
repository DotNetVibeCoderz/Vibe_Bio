<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Biotech.Net.Data</RootNamespace>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <Description>Cloud data connectors for NCBI E-utilities, UniProt, RCSB PDB, AlphaFold DB and Ensembl REST, with per-host rate limiting, retries and an on-disk/in-memory response cache with offline mode. Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.</Description>
    <PackageTags>$(PackageTags);ncbi;entrez;uniprot;pdb;alphafold;ensembl;vep;rest;cache</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Biotech.Net.Core/Biotech.Net.Core.csproj" />
    <ProjectReference Include="../Biotech.Net.Sequences/Biotech.Net.Sequences.csproj" />
    <ProjectReference Include="../Biotech.Net.Genomics/Biotech.Net.Genomics.csproj" />
    <ProjectReference Include="../Biotech.Net.StructuralBiology/Biotech.Net.StructuralBiology.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Biotech.Net.Data.Tests" />
  </ItemGroup>

</Project>
