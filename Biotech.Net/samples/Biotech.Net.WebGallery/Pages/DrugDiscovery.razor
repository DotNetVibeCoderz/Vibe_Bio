@page "/drug-discovery"
@using Biotech.Net.Chemistry
@using Biotech.Net.DrugDiscovery
@using Biotech.Net.Visualization
@inject IJSRuntime JS

<PageFrame Title="Drug Discovery Lab" Modules="BIOTECH.NET.CHEMISTRY · BIOTECH.NET.DRUGDISCOVERY · VISUALIZATION"
           Lede="Type a SMILES string to depict the molecule, compute RDKit-compatible descriptors, check drug-likeness and ADMET flags, and rank a built-in library of approved drugs by fingerprint similarity."
           Trace="@trace" TraceLabel="TRACE · SMILES encoded 2 bases/char" Status="@status" Code="@snippet">
    <Actions>
        <button class="quiet" type="button" @onclick="SaveSvg" disabled="@(svgText is null)">Save SVG</button>
    </Actions>
    <ChildContent>
        <div class="split wide-input">
            <div class="col-input">
                <Panel Title="SMILES">
                    <input class="seq-line" spellcheck="false" aria-label="SMILES" @bind="smiles" @bind:after="Analyze" />
                    <div class="chips">
                        @foreach (var (name, smi) in Library.Take(12))
                        {
                            <button class="chip @(smi == smiles ? "on" : "")" type="button" @onclick="() => Pick(smi)">@name</button>
                        }
                    </div>
                    <div class="actions"><button class="primary" type="button" @onclick="Analyze">Analyze</button></div>
                </Panel>
                @if (mol is not null)
                {
                    <Panel Title="2-D depiction" Aside="@formula">
                        <div class="figure-well">@depiction</div>
                        <p class="caption mono">@mol.ToSmiles()</p>
                    </Panel>
                    <Panel Title="Structural alerts" Aside="@(alerts.Count == 0 ? "clean" : $"{alerts.Count} matched")">
                        @if (alerts.Count == 0)
                        {
                            <p class="caption">No PAINS or Brenk alerts matched.</p>
                        }
                        else
                        {
                            @foreach (var a in alerts)
                            {
                                <div class="mono t">@a.Family · @a.Name</div>
                            }
                        }
                    </Panel>
                }
            </div>

            <div class="col-results">
                @if (error is not null)
                {
                    @Bench.Notice(errorTitle, error)
                }
                else if (d is not null && admet is not null)
                {
                    <Panel Title="@(string.IsNullOrEmpty(mol!.Name) ? "Descriptors" : $"{mol.Name} · descriptors")" Aside="@($"computed in {elapsed}")">
                        <div class="readouts">
                            <Readout Label="MW" Value="@Bench.F(d.MolecularWeight, "0.0")" Unit="Da" />
                            <Readout Label="cLogP" Value="@Bench.F(d.LogP, "0.00")" Dye="g" />
                            <Readout Label="TPSA" Value="@Bench.F(d.Tpsa, "0.0")" Unit="Å²" />
                            <Readout Label="HBD / HBA" Value="@($"{d.LipinskiHbd}/{d.LipinskiHba}")" />
                            <Readout Label="RotB" Value="@d.RotatableBonds.ToString()" />
                            <Readout Label="QED" Value="@Bench.F(admet.Qed, "0.00")" Dye="a" />
                        </div>
                    </Panel>
                    <Panel Title="Drug-likeness rules" Aside="@($"{admet.Rules.Count(r => r.Passed)}/{admet.Rules.Count} pass")">
                        <div class="tags">
                            @foreach (var r in admet.Rules)
                            {
                                <span class="tag @(r.Passed ? "pass" : "fail")">@(r.Passed ? "PASS" : "FAIL")&nbsp; @r.Rule@(r.Passed ? "" : $" · {string.Join(", ", r.Violations)}")</span>
                            }
                        </div>
                    </Panel>
                    <div class="grid-2">
                        <Panel Title="ADMET profile" Aside="heuristic models">
                            <dl class="kv">
                                <dt>ESOL logS</dt><dd>@Bench.F(admet.EsolLogS, "0.00")</dd>
                                <dt>Solubility</dt><dd>@($"{admet.EsolSolubilityMgPerL.ToString("0.##", CultureInfo.InvariantCulture)} mg/L · {admet.SolubilityClass}")</dd>
                                <dt>GI absorption (BOILED-Egg)</dt><dd class="@(admet.GiAbsorption ? "a" : "t")">@(admet.GiAbsorption ? "high" : "low")</dd>
                                <dt>Blood–brain barrier</dt><dd class="@(admet.BloodBrainBarrier ? "c" : "")">@(admet.BloodBrainBarrier ? "permeant" : "not permeant")</dd>
                                <dt>hERG risk</dt><dd class="@(admet.HergRisk >= 0.5 ? "t" : "")">@Bench.F(admet.HergRisk, "0.00")</dd>
                                <dt>P-gp substrate (likely)</dt><dd>@(admet.LikelyPgpSubstrate ? "yes" : "no")</dd>
                                <dt>CYP inhibition flags</dt><dd>@(string.Join(" ", admet.CypFlags.Where(kv => kv.Value).Select(kv => kv.Key)) is { Length: > 0 } cyp ? cyp : "none")</dd>
                                <dt>Synthetic complexity</dt><dd>@Bench.F(admet.Complexity, "0.00")</dd>
                                <dt>Fraction Csp3 · rings</dt><dd>@($"{d.FractionCsp3.ToString("0.00", CultureInfo.InvariantCulture)} · {d.RingCount} ({d.AromaticRingCount} aromatic)")</dd>
                            </dl>
                        </Panel>
                        <Panel Title="Similarity screen" Aside="@($"{Library.Length} drugs · ECFP4 + MACCS")">
                            <table class="data">
                                <thead><tr><th>#</th><th>Compound</th><th>Score</th><th>ECFP4</th><th>MACCS</th></tr></thead>
                                <tbody>
                                    @foreach (var h in hits)
                                    {
                                        <tr>
                                            <td class="rank">@h.Rank</td>
                                            <td class="@(h.Score > 0.99 ? "g" : "")">@h.Id</td>
                                            <td><span class="meter"><i style="width:@((h.Score * 100).ToString("0", CultureInfo.InvariantCulture))%"></i></span>@Bench.F(h.Score, "0.00")</td>
                                            <td class="muted">@(h.PerFingerprint.TryGetValue(FingerprintType.Ecfp4, out var e) ? Bench.F(e, "0.00") : "—")</td>
                                            <td class="muted">@(h.PerFingerprint.TryGetValue(FingerprintType.Maccs, out var m) ? Bench.F(m, "0.00") : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </Panel>
                    </div>
                }
            </div>
        </div>
    </ChildContent>
</PageFrame>

@code {
    /// <summary>The built-in screening library: approved drugs across a few target classes (same as the desktop Gallery).</summary>
    private static readonly (string Name, string Smiles)[] Library =
    [
        ("Imatinib", "Cc1ccc(NC(=O)c2ccc(CN3CCN(C)CC3)cc2)cc1Nc1nccc(-c2cccnc2)n1"),
        ("Nilotinib", "Cc1cn(-c2cc(NC(=O)c3ccc(C)c(Nc4nccc(-c5cccnc5)n4)c3)cc(C(F)(F)F)c2)cn1"),
        ("Gefitinib", "COc1cc2ncnc(Nc3ccc(F)c(Cl)c3)c2cc1OCCCN1CCOCC1"),
        ("Erlotinib", "COCCOc1cc2ncnc(Nc3cccc(C#C)c3)c2cc1OCCOC"),
        ("Dasatinib", "Cc1nc(Nc2ncc(C(=O)Nc3c(C)cccc3Cl)s2)cc(N2CCN(CCO)CC2)n1"),
        ("Aspirin", "CC(=O)Oc1ccccc1C(=O)O"),
        ("Ibuprofen", "CC(C)Cc1ccc(C(C)C(=O)O)cc1"),
        ("Naproxen", "COc1ccc2cc(C(C)C(=O)O)ccc2c1"),
        ("Diclofenac", "OC(=O)Cc1ccccc1Nc1c(Cl)cccc1Cl"),
        ("Celecoxib", "Cc1ccc(-c2cc(C(F)(F)F)nn2-c2ccc(S(N)(=O)=O)cc2)cc1"),
        ("Paracetamol", "CC(=O)Nc1ccc(O)cc1"),
        ("Caffeine", "Cn1cnc2c1c(=O)n(C)c(=O)n2C"),
        ("Sildenafil", "CCCc1nn(C)c2c(=O)[nH]c(-c3cc(S(=O)(=O)N4CCN(C)CC4)ccc3OCC)nc12"),
        ("Metformin", "CN(C)C(=N)N=C(N)N"),
        ("Fluoxetine", "CNCCC(Oc1ccc(C(F)(F)F)cc1)c1ccccc1"),
        ("Atenolol", "CC(C)NCC(O)COc1ccc(CC(N)=O)cc1"),
        ("Nicotine", "CN1CCCC1c1cccnc1"),
        ("Diazepam", "CN1C(=O)CN=C(c2ccccc2)c2cc(Cl)ccc21"),
    ];

    private string smiles = Library[0].Smiles;
    private Molecule? mol;
    private DescriptorSet? d;
    private AdmetProfile? admet;
    private IReadOnlyList<StructuralAlert> alerts = [];
    private IReadOnlyList<ScreeningHit> hits = [];
    private static IReadOnlyList<LibraryCompound>? _library;
    private MarkupString depiction;
    private string? svgText, error, trace;
    private string errorTitle = "", formula = "", elapsed = "", status = "", snippet = "";

    protected override void OnInitialized() => Analyze();

    private void Pick(string smi) { smiles = smi; Analyze(); }

    private void Analyze()
    {
        string smi = smiles.Trim();
        string name = Library.FirstOrDefault(x => x.Smiles == smi).Name ?? "";
        var parsed = SmilesParser.TryParse(smi, name);
        if (parsed is null)
        {
            errorTitle = "SMILES could not be parsed";
            error = "Check ring-closure digits, brackets and aromatic atoms (lower-case c, n, o, s), or start from one of the presets.";
            status = $"\"{smi}\" is not valid SMILES.";
            mol = null; d = null; admet = null;
            return;
        }
        try
        {
            error = null;
            mol = parsed;
            var sw = Stopwatch.StartNew();
            d = MolecularDescriptors.Compute(mol);
            admet = Admet.Profile(mol);
            alerts = StructuralAlerts.Match(mol);
            _library ??= Library.Select(x => LibraryCompound.FromSmiles(x.Name, x.Smiles)).ToList();
            hits = SimilarityScreen.Run(mol, _library, new SimilarityScreenOptions
            {
                Fingerprints = [FingerprintType.Ecfp4, FingerprintType.Maccs],
                TopK = 8,
            });
            var viewer = new MoleculeViewer(mol, 420, 330) { Theme = Bench.PlotTheme, ShowFormula = true };
            if (alerts.Count > 0) viewer.HighlightAtoms = alerts.SelectMany(a => a.Pattern.Matches(mol).SelectMany(m => m)).ToHashSet();
            depiction = Bench.Svg(viewer);
            try { svgText = viewer.ToSvg(); } catch { svgText = null; }
            sw.Stop();
            elapsed = GalleryData.Ms(sw);
            formula = d.Formula;
            trace = GalleryData.TextToBases(smi);
            status = $"{d.Formula} · MW {d.MolecularWeight:0.00} · cLogP {d.LogP:0.00} · TPSA {d.Tpsa:0.0} · QED {admet.Qed:0.00} · nearest {hits.FirstOrDefault()?.Id} · {elapsed}";
            snippet = Snippet(smi);
        }
        catch (Exception ex)
        {
            errorTitle = "Analysis failed";
            error = Bench.Explain(ex);
            status = "Analysis failed: " + ex.Message;
        }
    }

    private async Task SaveSvg()
    {
        if (svgText is not null) await JS.InvokeVoidAsync("gallery.download", (mol?.Name is { Length: > 0 } n ? n : "molecule") + ".svg", "image/svg+xml", svgText);
    }

    private static string Snippet(string smi) => $$"""
        using Biotech.Net.Chemistry;
        using Biotech.Net.DrugDiscovery;
        using Biotech.Net.Visualization;

        var mol = Molecule.FromSmiles({{GalleryData.Literal(smi)}});

        // RDKit-compatible descriptors and drug-likeness
        DescriptorSet d = MolecularDescriptors.Compute(mol);
        Console.WriteLine($"{d.Formula} MW={d.MolecularWeight:0.00} cLogP={d.LogP:0.00} TPSA={d.Tpsa:0.0}");
        Console.WriteLine(DrugLikeness.Lipinski(d));

        // ADMET profile (ESOL, BOILED-Egg, hERG, CYP flags, QED) and structural alerts
        AdmetProfile admet = Admet.Profile(mol);
        Console.WriteLine(admet);
        foreach (var alert in StructuralAlerts.Match(mol)) Console.WriteLine($"alert: {alert.Family} {alert.Name}");

        // Similarity screen against a small library (ECFP4 + MACCS, mean fusion)
        var library = new[]
        {
            LibraryCompound.FromSmiles("Imatinib", "Cc1ccc(NC(=O)c2ccc(CN3CCN(C)CC3)cc2)cc1Nc1nccc(-c2cccnc2)n1"),
            LibraryCompound.FromSmiles("Gefitinib", "COc1cc2ncnc(Nc3ccc(F)c(Cl)c3)c2cc1OCCCN1CCOCC1"),
            LibraryCompound.FromSmiles("Aspirin", "CC(=O)Oc1ccccc1C(=O)O"),
            LibraryCompound.FromSmiles("Caffeine", "Cn1cnc2c1c(=O)n(C)c(=O)n2C"),
        };
        foreach (var h in SimilarityScreen.Run(mol, library, new SimilarityScreenOptions { Fingerprints = [FingerprintType.Ecfp4, FingerprintType.Maccs], TopK = 4 }))
            Console.WriteLine($"{h.Rank}. {h.Id,-10} {h.Score:F3}");

        // 2-D depiction
        Show(new MoleculeViewer(mol, 420, 330) { Theme = BioTheme.Dark });
        """;
}
